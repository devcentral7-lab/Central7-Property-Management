# =============================================================================
# Central7 Pulse — PRODUCTION environment
# Copy values from your hosts (Supabase / Render|Railway / Google Cloud).
# Replace every REPLACE_ME_* placeholder before deploy. Never commit real secrets.
# =============================================================================

NODE_ENV=production
PORT=3000

# Public app URLs
APP_URL=https://REPLACE_ME_APP_HOST
API_URL=https://REPLACE_ME_API_HOST
CORS_ORIGIN=https://REPLACE_ME_APP_HOST

# -----------------------------------------------------------------------------
# Supabase (NEW production project — not the legacy GAS database)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://REPLACE_ME_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=REPLACE_ME_SUPABASE_JWT_SECRET

# -----------------------------------------------------------------------------
# Legacy Supabase (optional — only for one-off migration exports)
# -----------------------------------------------------------------------------
LEGACY_SUPABASE_URL=https://rbqgtzqdvzjnrzwehvcs.supabase.co
LEGACY_SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_LEGACY_SERVICE_ROLE_KEY

# -----------------------------------------------------------------------------
# Google Drive (property + user photos)
# Prefer path to JSON key file in production, or paste minified JSON carefully.
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=REPLACE_ME_PATH_OR_INLINE_JSON
PHOTOS_ROOT_FOLDER_ID=1RJ1xTzHptaNdAfiZ3z8v1_CN_FfR6Th0

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY
USD_TO_LKR_FALLBACK_RATE=335

# -----------------------------------------------------------------------------
# Session / security
# -----------------------------------------------------------------------------
SESSION_COOKIE_NAME=c7_session
# Generate with: openssl rand -base64 48
SESSION_SECRET=REPLACE_ME_LONG_RANDOM_SECRET

# Rate limits (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
