{
  "name": "central7-property-management",
  "version": "0.1.0",
  "private": true,
  "description": "Central7 Pulse rebuild — Node.js + Supabase",
  "type": "module",
  "scripts": {
    "migrate:export": "tsx scripts/migrate/export-legacy.ts",
    "migrate:profile": "tsx scripts/migrate/profile-raw.ts",
    "migrate:clean": "tsx scripts/migrate/clean.ts",
    "migrate:schema": "tsx scripts/migrate/apply-schema.ts",
    "migrate:load": "tsx scripts/migrate/load.ts",
    "migrate:update-view": "tsx scripts/migrate/update-view-from-excel.ts",
    "migrate:update-parking": "tsx scripts/migrate/update-parking-from-excel.ts",
    "seed:staff": "tsx scripts/seed-staff.ts",
    "seed:agent": "tsx scripts/seed-agent.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/xlsx": "^0.0.35",
    "pg": "^8.23.0",
    "supabase": "^2.117.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
