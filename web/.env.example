# Copy to `.env.local` in this folder (Next.js only loads env from `web/`).

NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_SUPABASE_ANON_KEY

# Server-only — Admin user registration (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — used by Add listing AI extract (never NEXT_PUBLIC_)
GEMINI_API_KEY=
# Optional override (default: gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-lite-latest

# Server-only — Google Drive property photos (optional; app works without these)
# Paste the full service-account JSON as a single line, or a local file path in dev.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Drive folder that contains per-ref photo folders (C7-xxxxx)
PHOTOS_ROOT_FOLDER_ID=1RJ1xTzHptaNdAfiZ3z8v1_CN_FfR6Th0

# Browser key for the "Pin on Google Maps" picker (optional; button shows a
# "coming soon" dialog while unset). Enable Maps JavaScript API + Geocoding API
# (Geocoding auto-fills City from the pin) and restrict the key to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
